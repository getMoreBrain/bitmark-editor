<header class="site-header">
  <button type="button" class="menu-toggle" aria-controls="sidebar" aria-expanded="false" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>
  <a href="/" class="header-logo" aria-label="bitmark editor home">
    <img class="logo-light" src="/assets/images/bitmark_logo.png" alt="[.bitmark]" height="28" />
    <img class="logo-dark" src="/assets/images/bitmark_logo_dark.png" alt="[.bitmark]" height="28" />
    <span class="header-product">editor</span>
  </a>
  <div class="header-search">
    {# Pagefind's search (built by npm run build:site; absent in dev, where the
       trigger stays hidden until its element is defined). #}
    <pagefind-config bundle-path="{{ '/pagefind/' | htmlBaseUrl }}"></pagefind-config>
    <pagefind-modal-trigger placeholder="Search the docs"></pagefind-modal-trigger>
    <pagefind-modal></pagefind-modal>
  </div>
  <div class="header-controls">
    <a class="version-badge" href="{{ site.npm }}" rel="noopener">v{{ site.version }}</a>
    <button type="button" class="theme-toggle" data-theme-toggle aria-label="Theme: follow the system">
      <svg class="icon-system" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
      <svg class="icon-light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="icon-dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    </button>
    <a class="header-github" href="{{ site.repo }}" rel="noopener" aria-label="GitHub repository">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5z"/></svg>
    </a>
  </div>
</header>
