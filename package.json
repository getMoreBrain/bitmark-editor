{
  "name": "@gmb/bitmark-editor-workspace",
  "private": true,
  "description": "Workspace for @gmb/bitmark-editor and @gmb/bitmark-editor-angular",
  "author": "Get More Brain Ltd",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getMoreBrain/bitmark-editor.git"
  },
  "workspaces": [
    "packages/bitmark-editor",
    "packages/bitmark-editor/examples"
  ],
  "scripts": {
    "build": "npm run build -w @gmb/bitmark-editor",
    "build:angular": "cd packages/bitmark-editor-angular && npx ng build bitmark-editor-angular && npx ng build example",
    "build:docs": "npm run docs -w @gmb/bitmark-editor",
    "build:pages": "npm run build:pages -w bitmark-editor-examples",
    "build:examples": "node scripts/example-apps.mjs build",
    "typecheck": "npm run typecheck -w @gmb/bitmark-editor",
    "lint": "eslint . --max-warnings 0 && npm run lint -w @gmb/bitmark-editor",
    "lint:fix": "eslint . --fix --max-warnings 0 && npm run lint -w @gmb/bitmark-editor -- --fix",
    "test": "npm run test -w @gmb/bitmark-editor",
    "test:browser": "npm run test -w bitmark-editor-examples",
    "test:pages": "npm run test:pages -w bitmark-editor-examples",
    "test:angular": "cd packages/bitmark-editor-angular/e2e && npx playwright test -c playwright.config.mjs",
    "test:examples": "node scripts/example-apps.mjs test",
    "check:package": "npm pack --dry-run -w @gmb/bitmark-editor && publint packages/bitmark-editor && attw --pack packages/bitmark-editor --profile esm-only",
    "check:package:angular": "cd packages/bitmark-editor-angular/dist/bitmark-editor-angular && npm pack --dry-run && publint . && attw --pack . --profile esm-only",
    "install:angular": "npm ci --prefix packages/bitmark-editor-angular",
    "install:examples": "node scripts/example-apps.mjs install",
    "pack:examples": "node scripts/example-apps.mjs pack",
    "start:example:vanilla-ts": "npm --prefix examples/vanilla-ts run dev --",
    "start:example:react": "npm --prefix examples/react run dev --",
    "start:example:angular": "npm --prefix examples/angular start --",
    "release:version": "node scripts/release.mjs version",
    "release:check": "node scripts/release.mjs check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@ncoderz/awa": "^1.10.3",
    "eslint": "^10.12.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "3.9.9",
    "publint": "^0.3.25"
  },
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22"
  }
}
